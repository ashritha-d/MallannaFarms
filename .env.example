# Copy this file to .env.local and fill in your own values.
# (.env.local — not .env — because Vercel's CLI (`vercel dev`, used for
# full-stack local dev) reads that file by convention, and because these
# are all server-only secrets that must never be exposed to the browser.)
#
# None of these carry a VITE_ prefix on purpose — Vite inlines VITE_*
# variables into the browser bundle, which was fine for the old Supabase
# anon key (safe to expose, protected by RLS) but would leak these secrets
# if prefixed the same way. The frontend never reads these directly; it
# only talks to /api, which reads them server-side.

# MongoDB Atlas connection string.
# Get this from: Atlas Dashboard → Database → Connect → Drivers → copy the
# connection string, then fill in your database user's password.
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/mallanna-farms?retryWrites=true&w=majority

# Any long random string — signs the admin login session (JWT). Generate one
# with, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# Cloudinary — get these from: Cloudinary Dashboard → home page (Account
# Details card). Used to sign direct-from-browser uploads for product
# photos, gallery images and videos in /admin.
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
