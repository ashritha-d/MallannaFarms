# Copy this file to .env and fill in your own Supabase project credentials.
# Get these from: Supabase Dashboard → Project Settings → API
#
# VITE_SUPABASE_URL is your Project URL (e.g. https://xxxxx.supabase.co)
# VITE_SUPABASE_ANON_KEY is the "anon public" key — safe to expose in the
# browser because every table is protected by Row Level Security policies
# (see supabase/schema.sql). NEVER put the "service_role" key in this file
# or anywhere in frontend code — it bypasses RLS entirely.

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
